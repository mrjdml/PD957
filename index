<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PD 957 Reviewer — Subdivision and Condominium Buyers Protective Decree</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,400;0,500;0,600;0,700;1,400&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap');

:root{
  --brick:#2b3a67; --brick-2:#1d2848; --wheat:#e07a5f; --wheat-light:#f6c5b5;
  --forest:#3d405b; --forest-light:#6b6f91; --parchment:#f6f4fa; --parchment-2:#ebe7f3;
  --line:#d6d0e4; --ink:#1c1b2e; --ink-soft:#55526f;
  --sans:'IBM Plex Sans', system-ui, -apple-system, sans-serif;
  --serif:'Spectral', Georgia, 'Times New Roman', serif;
  --mono:'IBM Plex Mono', monospace;
}
*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{
  background:var(--brick);
  color:var(--ink);
  font-family:var(--sans);
  -webkit-font-smoothing:antialiased;
}
::selection{background:var(--wheat-light); color:var(--brick);}

.app{ display:grid; grid-template-columns:260px 1fr; min-height:100vh; }
@media (max-width:900px){ .app{grid-template-columns:1fr;} }

.sidebar{
  background:var(--brick); color:#e9ddd0; padding:28px 20px 24px;
  position:sticky; top:0; height:100vh; overflow-y:auto;
  border-right:1px solid rgba(232,200,119,0.18);
}
@media (max-width:900px){
  .sidebar{position:static; height:auto; border-right:none; border-bottom:1px solid rgba(232,200,119,0.18); padding:18px 16px;}
}
.crest{ display:flex; align-items:center; gap:12px; margin-bottom:22px; }
.crest-mark{
  width:44px;height:44px;flex:0 0 44px; border-radius:50%;
  background:radial-gradient(circle at 32% 28%, var(--wheat-light), var(--wheat) 55%, #8a611c 100%);
  display:flex;align-items:center;justify-content:center;
  font-family:var(--serif); font-weight:700; color:var(--brick); font-size:13px;
  box-shadow:0 0 0 3px rgba(232,200,119,0.15);
}
.crest-text .k1{font-family:var(--serif); font-size:19px; font-weight:600; color:#f7f0da; line-height:1.1;}
.crest-text .k2{font-size:11px; letter-spacing:.04em; color:#c2ac93; margin-top:2px;}

.nav-group-label{ font-size:10.5px; text-transform:uppercase; letter-spacing:.11em; color:#a68f76; margin:20px 0 8px; font-weight:600; }
.nav-group-label:first-of-type{margin-top:4px;}
nav.tabs{display:flex; flex-direction:column; gap:2px;}
@media (max-width:900px){ nav.tabs{flex-direction:row; flex-wrap:wrap;} }
.tab-btn{
  all:unset; cursor:pointer; display:flex; align-items:center; gap:10px;
  padding:9px 10px; border-radius:7px; font-size:13.5px; color:#d9c8b5;
  transition:background .15s ease, color .15s ease;
}
.tab-btn:hover{background:rgba(232,200,119,0.08); color:#f7f0da;}
.tab-btn.active{background:rgba(232,200,119,0.14); color:#f7f0da; font-weight:600;}
.tab-btn .dot{width:6px;height:6px;border-radius:50%;background:#7a5c47; flex:0 0 6px;}
.tab-btn.active .dot{background:var(--wheat-light);}

.side-foot{ margin-top:26px; padding-top:16px; border-top:1px solid rgba(232,200,119,0.15); font-size:11px; color:#a68f76; line-height:1.6; }

main.content{ background:var(--parchment); min-height:100vh; }
.topbar{
  position:sticky; top:0; z-index:20; background:var(--parchment); border-bottom:1px solid var(--line);
  padding:16px 32px; display:flex; gap:16px; align-items:center;
}
@media (max-width:640px){ .topbar{padding:12px 16px; flex-wrap:wrap;} }
.search-wrap{flex:1; position:relative; max-width:480px;}
.search-wrap input{
  width:100%; padding:10px 14px 10px 36px; border-radius:8px; border:1px solid var(--line);
  background:#fff; font-family:var(--sans); font-size:13.5px; color:var(--ink); outline:none;
}
.search-wrap input:focus{border-color:var(--wheat);}
.search-wrap svg{position:absolute; left:11px; top:50%; transform:translateY(-50%); opacity:.45;}
.topbar-title{font-family:var(--serif); font-size:15px; color:var(--ink-soft); margin-left:auto; white-space:nowrap;}
@media (max-width:640px){ .topbar-title{display:none;} }

.view{padding:32px; max-width:940px; margin:0 auto;}
@media (max-width:640px){ .view{padding:20px 16px;} }
.view-header{margin-bottom:26px;}
.eyebrow-row{display:flex; align-items:center; gap:10px; margin-bottom:8px;}
.badge-pill{ font-family:var(--mono); font-size:10.5px; letter-spacing:.05em; background:var(--brick); color:var(--wheat-light); padding:3px 9px; border-radius:20px; }
h1.view-title{font-family:var(--serif); font-size:32px; font-weight:600; margin:0 0 8px; color:var(--brick); line-height:1.15;}
p.view-sub{font-size:14.5px; color:var(--ink-soft); max-width:62ch; line-height:1.6; margin:0;}

.stat-row{display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin:24px 0 30px;}
@media (max-width:700px){ .stat-row{grid-template-columns:repeat(2,1fr);} }
.stat-card{ background:#fff; border:1px solid var(--line); border-radius:10px; padding:16px; }
.stat-card .n{font-family:var(--serif); font-size:24px; color:var(--forest); font-weight:600; line-height:1;}
.stat-card .l{font-size:11.5px; color:var(--ink-soft); margin-top:6px;}

.home-timeline{border-left:2px solid var(--line); margin-left:8px; padding-left:22px; display:flex; flex-direction:column; gap:20px;}
.tl-item{position:relative;}
.tl-item::before{
  content:''; position:absolute; left:-28.5px; top:3px; width:11px; height:11px; border-radius:50%;
  background:var(--wheat); border:2px solid var(--parchment); box-shadow:0 0 0 2px var(--wheat);
}
.tl-date{font-family:var(--mono); font-size:12px; color:var(--forest); font-weight:600;}
.tl-title{font-family:var(--serif); font-size:16.5px; font-weight:600; color:var(--brick); margin:2px 0 3px;}
.tl-desc{font-size:13.5px; color:var(--ink-soft); line-height:1.55; max-width:64ch;}

.quicklinks{display:grid; grid-template-columns:repeat(2,1fr); gap:12px; margin-top:26px;}
@media (max-width:640px){ .quicklinks{grid-template-columns:1fr;} }
.qlink{ display:block; text-decoration:none; background:#fff; border:1px solid var(--line); border-radius:10px; padding:16px 18px; cursor:pointer; transition:border-color .15s, transform .1s; }
.qlink:hover{border-color:var(--wheat);}
.qlink .qt{font-family:var(--serif); font-weight:600; color:var(--brick); font-size:15px;}
.qlink .qd{font-size:12.5px; color:var(--ink-soft); margin-top:4px;}

.article-block{margin-bottom:34px;}
.article-heading{
  font-family:var(--serif); font-size:19px; font-weight:600; color:var(--brick);
  padding-bottom:8px; margin-bottom:14px; border-bottom:2px solid var(--wheat);
  display:flex; align-items:baseline; gap:10px;
}
.article-heading .tag{font-family:var(--mono); font-size:11px; color:var(--forest); font-weight:600;}

.sec-card{ background:#fff; border:1px solid var(--line); border-radius:10px; margin-bottom:10px; overflow:hidden; }
.sec-head{ all:unset; box-sizing:border-box; cursor:pointer; width:100%; display:flex; align-items:center; gap:12px; padding:14px 16px; }
.sec-num{ font-family:var(--mono); font-size:12px; color:#fff; background:var(--brick); padding:3px 8px; border-radius:5px; flex:0 0 auto; white-space:nowrap; }
.sec-title{font-family:var(--serif); font-weight:600; font-size:15px; color:var(--ink); flex:1;}
.sec-chevron{transition:transform .2s ease; color:var(--ink-soft); flex:0 0 auto;}
.sec-card.open .sec-chevron{transform:rotate(180deg);}
.sec-body{ max-height:0; overflow:hidden; transition:max-height .25s ease; padding:0 16px; }
.sec-card.open .sec-body{padding:0 16px 16px;}
.sec-body-inner{font-size:14px; line-height:1.65; color:var(--ink);}
.sec-body-inner p{margin:0 0 10px;}
.sec-body-inner ul{margin:0 0 10px; padding-left:20px;}
.sec-body-inner li{margin-bottom:5px;}
.kw{ background:linear-gradient(transparent 60%, var(--wheat-light) 60%); font-weight:600; }
.trap-box{ background:#eaf0e7; border-left:3px solid var(--forest); border-radius:6px; padding:10px 12px; font-size:13px; color:#20351d; margin-top:8px; display:flex; gap:8px; }
.trap-box .lbl{font-family:var(--mono); font-weight:700; font-size:10.5px; color:var(--forest); white-space:nowrap; padding-top:1px;}

.glossary-grid{display:grid; grid-template-columns:1fr; gap:10px;}
.g-card{background:#fff; border:1px solid var(--line); border-radius:10px; padding:14px 16px;}
.g-term{font-family:var(--serif); font-weight:700; color:var(--brick); font-size:15px;}
.g-abbr{font-family:var(--mono); font-size:11px; color:var(--forest); margin-left:6px;}
.g-def{font-size:13.5px; color:var(--ink-soft); margin-top:4px; line-height:1.55;}

.people-grid{display:grid; grid-template-columns:repeat(2,1fr); gap:14px;}
@media (max-width:640px){ .people-grid{grid-template-columns:1fr;} }
.p-card{background:#fff; border:1px solid var(--line); border-radius:10px; padding:16px;}
.p-name{font-family:var(--serif); font-weight:700; color:var(--brick); font-size:16px;}
.p-role{font-size:11.5px; color:var(--forest); font-weight:600; margin:2px 0 8px; text-transform:uppercase; letter-spacing:.03em;}
.p-desc{font-size:13px; color:var(--ink-soft); line-height:1.55;}

.trap-list{display:flex; flex-direction:column; gap:10px;}
.trap-item{ background:#fff; border:1px solid var(--line); border-left:4px solid var(--forest); border-radius:8px; padding:14px 16px; }
.trap-item .tnum{font-family:var(--mono); font-size:11px; color:var(--forest); font-weight:700;}
.trap-item .ttitle{font-family:var(--serif); font-weight:600; font-size:14.5px; color:var(--brick); margin:3px 0 4px;}
.trap-item .tbody{font-size:13.5px; color:var(--ink-soft); line-height:1.55;}

.quiz-box{background:#fff; border:1px solid var(--line); border-radius:12px; padding:22px;}
.quiz-progress{font-family:var(--mono); font-size:11.5px; color:var(--ink-soft); margin-bottom:10px;}
.quiz-q{font-family:var(--serif); font-size:17px; font-weight:600; color:var(--brick); margin-bottom:16px; line-height:1.4;}
.quiz-opts{display:flex; flex-direction:column; gap:8px;}
.quiz-opt{
  all:unset; box-sizing:border-box; cursor:pointer; display:block; padding:11px 14px;
  border:1px solid var(--line); border-radius:8px; font-size:13.5px; transition:border-color .15s, background .15s;
}
.quiz-opt:hover{border-color:var(--wheat);}
.quiz-opt.correct{background:#eaf3ea; border-color:#4c6b52; color:#284a2c; font-weight:600;}
.quiz-opt.wrong{background:#f7e6e1; border-color:#a8452e; color:#5c2317; font-weight:600;}
.quiz-opt.disabled{pointer-events:none;}
.quiz-explain{ margin-top:14px; padding:12px 14px; background:var(--parchment-2); border-radius:8px; font-size:13px; color:var(--ink-soft); line-height:1.55; display:none; }
.quiz-explain.show{display:block;}
.quiz-nav{display:flex; justify-content:space-between; align-items:center; margin-top:18px;}
.btn{ all:unset; cursor:pointer; font-family:var(--sans); font-weight:600; font-size:13px; background:var(--brick); color:#f7f0da; padding:10px 18px; border-radius:7px; }
.btn:hover{background:var(--brick-2);}
.btn.ghost{background:transparent; color:var(--ink-soft); border:1px solid var(--line);}
.quiz-score{font-family:var(--serif); font-size:22px; color:var(--brick); text-align:center; padding:20px 0;}
.quiz-score .sub{font-family:var(--sans); font-size:13px; color:var(--ink-soft); font-weight:400; margin-top:6px;}

.hidden{display:none !important;}
.nores{padding:40px 0; text-align:center; color:var(--ink-soft); font-size:14px;}
</style>
</head>
<body><div class="app"><aside class="sidebar"><div class="crest"><div class="crest-mark">957</div><div class="crest-text"><div class="k1">Buyers' Codex</div><div class="k2">PD 957 · REB &amp; REA</div></div></div>
<div class="nav-group-label">Reviewer</div><nav class="tabs"><button class="tab-btn active" data-tab="home"><span class="dot"></span>Overview</button><button class="tab-btn" data-tab="law"><span class="dot"></span>Core Provisions</button><button class="tab-btn" data-tab="duties"><span class="dot"></span>Developer Duties</button><button class="tab-btn" data-tab="buyer"><span class="dot"></span>Buyer Remedies</button><button class="tab-btn" data-tab="related"><span class="dot"></span>Related Laws</button></nav>
