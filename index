<div class="side-foot">Verify penalty figures and the current IRR against DHSUD issuances.</div></aside>
<main class="content"><div class="topbar"><div class="search-wrap"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg><input id="searchInput" type="text" placeholder="Search sections, terms, dates, traps…"></div><div class="topbar-title" id="topbarTitle">Overview</div></div><div class="view" id="viewRoot"></div></main></div>
<script>
const dates=[{"date": "Aug 26, 1972", "title": "RA 6552 — Maceda Law", "desc": "Protects buyers of real estate on installment who DEFAULT; the mirror-image counterpart of PD 957 Sec. 23, which protects buyers when the DEVELOPER defaults."}, {"date": "1975", "title": "PD 757 — NHA created", "desc": "Created the National Housing Authority, the first regulator under PD 957."}, {"date": "Jul 12, 1976", "title": "PD 957 signed", "desc": "Subdivision and Condominium Buyers' Protective Decree, signed by Pres. Ferdinand E. Marcos; responds to swindling, non-delivery of titles, unpaid real estate taxes and double sales."}, {"date": "Oct 14, 1977", "title": "PD 1216", "desc": "Amends Sec. 31 of PD 957: open space percentages (30% overall; 9/7/3.5% parks by density)."}, {"date": "Apr 2, 1978", "title": "PD 1344", "desc": "Gives the NHA power to issue a writ of execution and exclusive jurisdiction over buyer complaints under PD 957."}, {"date": "Feb 7, 1981", "title": "EO 648", "desc": "Regulatory and quasi-judicial functions move from the NHA to the Human Settlements Regulatory Commission (HSRC)."}, {"date": "Dec 17, 1986", "title": "EO 90", "desc": "HSRC becomes the HLURB; the agency most associated with PD 957 enforcement for 33 years."}, {"date": "Jan 22, 1996", "title": "Eugenio v. Drilon (G.R. 109404)", "desc": "Supreme Court holds Secs. 20, 21 and 23 of PD 957 apply retroactively and protect buyers whose developer failed to develop."}, {"date": "2009", "title": "Revised IRR of PD 957 (HLURB)", "desc": "Latest revised IRR cited in common reviewers; verify whether DHSUD has issued a newer one."}, {"date": "Feb 14, 2019", "title": "RA 11201 — DHSUD Act", "desc": "Abolishes HLURB; DHSUD regulates, HSAC adjudicates PD 957 cases."}];
const people=[{"name": "Pres. Ferdinand E. Marcos", "role": "Signed PD 957 (Jul 12, 1976)", "desc": "Also signed PD 1216 (1977) and PD 1344 (1978), which amend and enforce PD 957."}, {"name": "National Housing Authority (NHA)", "role": "Original regulator", "desc": "Held exclusive jurisdiction to regulate the real estate trade and business under Sec. 3, as supported by PD 1344."}, {"name": "HSRC / HLURB", "role": "Regulator 1981–2019", "desc": "Issued the Revised IRR and decided buyer complaints."}, {"name": "DHSUD", "role": "Current regulator", "desc": "Issues licenses to sell and certificates of registration; policy and regulation under RA 11201."}, {"name": "HSAC", "role": "Current adjudicator", "desc": "Human Settlements Adjudication Commission hears buyer complaints (refund, specific performance, unsound practices)."}, {"name": "Subdivision owner / developer", "role": "Primary duty-bearer", "desc": "Must register the project, get a license to sell, post a performance bond, complete the project and deliver title."}, {"name": "Dealers, brokers and salesmen", "role": "Regulated sellers", "desc": "Must be registered; relevant to REB candidates since brokers and salesmen of covered projects fall under the Decree."}, {"name": "Lot and unit buyers", "role": "Protected class", "desc": "Entitled to development per approved plans, title upon full payment, and non-forfeiture when the developer defaults."}];
const glossary=[{"term": "Owner", "abbr": "Sec. 2", "def": "Registered owner of the land."}, {"term": "Dealer", "abbr": "Sec. 2", "def": "Buys and sells lots or units for his own account."}, {"term": "Broker", "abbr": "Sec. 2", "def": "Acts for another for a commission."}, {"term": "Salesman", "abbr": "Sec. 2", "def": "Regularly employed by a broker."}, {"term": "Subdivision project", "abbr": "Sec. 2", "def": "Land partitioned primarily for residential purposes into lots offered to the public for sale."}, {"term": "Certificate of Registration", "abbr": "Sec. 4", "def": "Issued after the project is registered; precedes the license to sell."}, {"term": "License to Sell", "abbr": "Sec. 5", "def": "Required before any lot or unit may be sold."}, {"term": "Performance bond", "abbr": "Sec. 6", "def": "Guarantees completion of the development."}, {"term": "Non-forfeiture", "abbr": "Sec. 23", "def": "Buyer's payments cannot be forfeited when the developer fails to develop."}, {"term": "Delinquency interest", "abbr": "Sec. 23", "def": "Excluded from the refund."}, {"term": "Amortization interest", "abbr": "Sec. 23", "def": "Included in the refund."}, {"term": "HSAC", "abbr": "RA 11201", "def": "Current adjudicating body for PD 957 disputes."}];
const lawArticles=[{"heading": "Purpose, Coverage and Authority", "tag": "Secs. 1-3", "sections": [{"num": "Preamble", "title": "Why PD 957 was issued", "body": "<p>The whereas clauses cite reports of swindling and fraud by unscrupulous sellers and operators: <span class='kw'>failure to deliver titles</span> or titles free of liens, <span class='kw'>non-payment of real estate taxes</span>, and <span class='kw'>fraudulent double sales</span> of the same lot to different buyers. The Decree requires close supervision of subdivision and condominium businesses.</p>"}, {"num": "Sec. 1", "title": "Title", "body": "<p>The Decree is known as <span class='kw'>The Subdivision and Condominium Buyers' Protective Decree</span> (signed Jul 12, 1976).</p>"}, {"num": "Sec. 2", "title": "Key definitions", "body": "<ul><li><span class='kw'>Owner</span>: the registered owner of the land.</li><li><span class='kw'>Dealer</span>: engaged in buying and selling lots or units for his own account.</li><li><span class='kw'>Broker</span>: acts for another for a commission.</li><li><span class='kw'>Salesman</span>: regularly employed by a broker.</li><li><span class='kw'>Subdivision project</span>: land partitioned primarily for residential purposes into lots, offered to the public for sale in installment or other consideration.</li><li><span class='kw'>Condominium project</span> and <span class='kw'>condominium unit</span> follow the Condominium Act (RA 4726).</li></ul><div class='trap-box'><span class='lbl'>TRAP</span><span>A broker works for a commission on behalf of another; a dealer sells for his own account. The two are separate registrants.</span></div>"}, {"num": "Sec. 3", "title": "Authority to regulate", "body": "<p>The NHA (now DHSUD, with HSAC adjudicating) has <span class='kw'>exclusive jurisdiction</span> to regulate the real estate trade and business under the Decree.</p>"}]}, {"heading": "Registration and License to Sell", "tag": "Secs. 4-9, 15", "sections": [{"num": "Sec. 4", "title": "Registration of projects", "body": "<p>The owner or developer must <span class='kw'>register the project</span> with the regulator, with the approved subdivision or condominium plan, before selling; the registration is annotated on the title.</p>"}, {"num": "Sec. 5", "title": "License to Sell", "body": "<p>A registered owner or dealer <span class='kw'>may not sell</span> any lot or unit until a <span class='kw'>License to Sell</span> is issued. Selling without one is an offense (see Sec. 39).</p><div class='trap-box'><span class='lbl'>TRAP</span><span>Registration of the project (Sec. 4) is NOT the same as the license to sell (Sec. 5). Registration comes first; the license to sell is what allows actual selling.</span></div>"}, {"num": "Sec. 6", "title": "Performance bond", "body": "<p>A <span class='kw'>performance bond</span> guarantees completion of the development in accordance with the approved plans; it is the fallback when compliance deadlines are not met.</p>"}, {"num": "Sec. 9", "title": "Revocation", "body": "<p>The Certificate of Registration and License to Sell may be revoked on grounds such as <span class='kw'>misrepresentation</span> in a prospectus, brochure, circular or other literature distributed to buyers.</p>"}, {"num": "Sec. 15", "title": "Decision", "body": "<p>Per common summaries, the regulator must decide a revocation or suspension case within <span class='kw'>30 days</span> and may order revocation, suspension or forfeiture of the bond. Verify the exact wording in the text.</p>"}]}];
const dutiesArticles=[{"heading": "Obligations During the Sale and Development", "tag": "Secs. 17-22, 25, 31", "sections": [{"num": "Sec. 17", "title": "Registration of contracts", "body": "<p>Contracts to sell, deeds of sale and similar instruments must be <span class='kw'>registered by the seller</span> with the Register of Deeds where the property lies, <span class='kw'>whether or not the price is fully paid</span>. This protects buyers against double sales.</p>"}, {"num": "Sec. 18", "title": "Mortgages", "body": "<p>No mortgage may be made on a lot or unit by the owner or developer without the <span class='kw'>prior written approval of the regulator</span>, and the loan proceeds must go to the development of the project. The buyer must be notified.</p><div class='trap-box'><span class='lbl'>TRAP</span><span>A mortgage on the whole project without regulator approval is a violation. The mortgage must also be released or reduced as lots are sold so that title can be delivered.</span></div>"}, {"num": "Sec. 19", "title": "Advertisements", "body": "<p>Advertisements and other sales materials must conform to the approved plan; deviations are grounds for sanctions and registration revocation.</p>"}, {"num": "Sec. 20", "title": "Time of completion", "body": "<p>The developer must complete the development in accordance with the approved plan, facilities and amenities <span class='kw'>within the period stated in the plan</span> or a period the regulator fixes.</p>"}, {"num": "Sec. 21", "title": "Sales prior to the Decree", "body": "<p>For lots and units sold before the Decree, the developer must comply within <span class='kw'>2 years</span> from the Decree unless extended or covered by an adequate performance bond.</p>"}, {"num": "Sec. 22", "title": "Alteration of plans", "body": "<p>Roads, open spaces and facilities may not be altered without the regulator's permission and the conformity of the homeowners' association (or the majority of lot buyers).</p>"}, {"num": "Sec. 25", "title": "Issuance of title", "body": "<p>The owner or developer must <span class='kw'>deliver the title upon full payment</span>. No fee other than the registration of the deed of sale may be charged for issuing title.</p>"}, {"num": "Sec. 31", "title": "Roads, alleys, sidewalks and open spaces", "body": "<p>Amended by PD 1216 (1977): 30% overall open space for projects of 1 hectare or more; 9% / 7% / 3.5% for parks and playgrounds by density; donation to the LGU upon completion.</p>"}]}];
const buyerArticles=[{"heading": "Section 23 — Non-Forfeiture of Payments", "tag": "The core buyer remedy", "sections": [{"num": "Rule", "title": "Buyer may stop paying when the developer defaults", "body": "<p>No installment payments shall be <span class='kw'>forfeited</span> in favor of the owner or developer when the buyer, after due notice, <span class='kw'>desists from further payment</span> because the developer failed to develop the project according to the approved plans and within the time limit.</p>"}, {"num": "Refund", "title": "What the buyer can recover", "body": "<p>At his option the buyer may be reimbursed the <span class='kw'>total amount paid, including amortization interests but excluding delinquency interests</span>, with interest at the legal rate.</p><div class='trap-box'><span class='lbl'>TRAP</span><span>Refund includes amortization interest but EXCLUDES delinquency interest. Interest on the refund runs at the legal rate. Do not mix this with the Maceda Law refund (cash surrender value) which applies when the BUYER defaults.</span></div>"}, {"num": "Distinction", "title": "PD 957 vs. Maceda Law (RA 6552)", "body": "<table style='width:100%;border-collapse:collapse'><tr><th></th><th>PD 957 Sec. 23</th><th>Maceda Law</th></tr><tr><td>Who defaults</td><td>Developer</td><td>Buyer</td></tr><tr><td>Remedy</td><td>Stop paying; refund of amounts paid</td><td>Grace period; cash surrender value after 2 years of payments</td></tr><tr><td>Coverage</td><td>Subdivision lots and condo units</td><td>Residential real estate on installment</td></tr></table>"}, {"num": "Jurisprudence", "title": "Eugenio v. Drilon (G.R. 109404, Jan 22, 1996)", "body": "<p>The Court applied Secs. 20, 21 and 23 <span class='kw'>retroactively</span>, including to contracts made before the Decree, and upheld the buyer's right to stop paying where the developer failed to develop.</p>"}]}, {"heading": "Enforcement, Penalties and Forum", "tag": "Secs. 3, 9, 38-39", "sections": [{"num": "Forum", "title": "Where buyers file", "body": "<p>Complaints for unsound practices, refund and specific performance go to the housing regulator (HSAC, formerly HLURB/NHA), not the RTC (PD 1344; Solid Homes v. Payawal). A final decision may be enforced by writ of execution.</p>"}, {"num": "Sec. 38", "title": "Administrative fines", "body": "<p>The regulator may impose administrative fines (commonly cited as up to ₱10,000 per violation, adjusted by later issuances). Verify the current figures.</p>"}, {"num": "Sec. 39", "title": "Criminal penalties", "body": "<p>Commonly cited as a fine of up to ₱20,000, imprisonment of up to 10 years, or both; when the violator is a corporation, the responsible <span class='kw'>officers are personally liable</span>.</p><div class='trap-box'><span class='lbl'>TRAP</span><span>Bills to raise these penalties have been filed in Congress. Unless your syllabus says otherwise, use the figures of the Decree as written.</span></div>"}]}];
const relatedArticles=[{"heading": "Amendments and Enforcement Decrees", "tag": "", "sections": [{"num": "PD 1216 (1977)", "title": "Open space", "body": "<p>Amends Sec. 31; see the PD 1216 reviewer.</p>"}, {"num": "PD 1344 (1978)", "title": "Writ of execution", "body": "<p>Gives the regulator exclusive jurisdiction and enforcement power over PD 957 cases; 15-day finality.</p>"}, {"num": "BP 220 (1982)", "title": "Lower standards", "body": "<p>Lets economic and socialized housing meet lower design standards than PD 957 open-market projects.</p>"}]}, {"heading": "Laws That Overlap", "tag": "", "sections": [{"num": "RA 6552", "title": "Maceda Law", "body": "<p>Buyer-default counterpart to Sec. 23.</p>"}, {"num": "RA 4726", "title": "Condominium Act", "body": "<p>Defines condominium ownership; PD 957 regulates the SALE of units.</p>"}, {"num": "PD 1529", "title": "Property Registration Decree", "body": "<p>Sec. 17 registration of contracts works with Torrens registration and protects buyers against double sale; compare Civil Code Art. 1544 on double sales.</p>"}, {"num": "RA 7279 / RA 10884", "title": "UDHA and balanced housing", "body": "<p>Adds socialized housing obligations to developers; separate from PD 957's buyer protections.</p>"}, {"num": "RA 9646", "title": "RESA Law", "body": "<p>Brokers and salesmen of subdivision or condominium projects must also satisfy PD 957 registration.</p>"}, {"num": "RA 11201 (2019)", "title": "DHSUD", "body": "<p>DHSUD is the regulator; HSAC adjudicates.</p>"}]}, {"heading": "Also Review (Civil Code, Consumer and Local Government Laws)", "tag": "Gap-fillers", "sections": [{"num": "Civil Code Art. 1544", "title": "Double sale", "body": "<p>The classic double-sale rule (movables, immovables). PD 957 Sec. 17 registration of contracts is the statutory shield against double sale of lots and units. For immovables: first registrant in good faith; if none, first possessor in good faith; if none, the buyer with the oldest title in good faith.</p><div class='trap-box'><span class='lbl'>TRAP</span><span>PD 957 Sec. 17 requires the SELLER to register the contract; Art. 1544 is the general rule deciding who prevails between competing buyers.</span></div>"}, {"num": "Civil Code Art. 1191", "title": "Rescission of reciprocal obligations", "body": "<p>The injured party may choose fulfillment or rescission, with damages. Compare with PD 957 Sec. 23, which is a special statutory remedy with its own refund formula.</p>"}, {"num": "RA 7394 (1992)", "title": "Consumer Act of the Philippines", "body": "<p>General consumer protection against deceptive sales acts and misrepresentation; overlaps with PD 957 Sec. 9 (misrepresentation in sales literature) and Sec. 19 (advertisements). Verify whether your syllabus treats it as related.</p>"}, {"num": "RA 7160 (1991)", "title": "Local Government Code", "body": "<p>LGUs collect real property tax (the unpaid taxes problem in the PD 957 preamble), approve zoning and development permits, and receive the roads and open spaces donated under Sec. 31 as amended by PD 1216.</p>"}, {"num": "PD 757 / EO 648 / EO 90 / RA 11201", "title": "Agency chain", "body": "<p>NHA (1975) to HSRC (1981) to HLURB (1986) to DHSUD with HSAC (2019). The regulator named in a question depends on the year.</p>"}]}];
const traps=[{"t": "PD 957 and the Maceda Law are the same remedy", "b": "False. PD 957 Sec. 23 protects buyers when the DEVELOPER defaults; the Maceda Law protects buyers who DEFAULT in installment payments."}, {"t": "The refund under Sec. 23 includes all interest paid", "b": "False. It includes amortization interests but EXCLUDES delinquency interests, plus legal-rate interest on the refund."}, {"t": "Registering the project allows immediate sale", "b": "False. A License to Sell (Sec. 5) is also required."}, {"t": "A contract to sell need not be registered until fully paid", "b": "False. Sec. 17 requires registration whether or not the price is paid in full."}, {"t": "Developers may mortgage the project freely", "b": "False. Sec. 18 requires prior written approval of the regulator and proceeds must fund development."}, {"t": "Title may be delayed until the developer chooses", "b": "False. Sec. 25 requires delivery of title upon full payment."}, {"t": "PD 957 applies only to condominiums", "b": "False. It covers both subdivision lots and condominium units."}, {"t": "Buyers sue developers in the RTC under PD 957", "b": "False. The housing regulator (now HSAC) has exclusive jurisdiction (PD 1344; Solid Homes v. Payawal)."}, {"t": "HLURB enforces PD 957 today", "b": "Outdated. DHSUD regulates and HSAC adjudicates since RA 11201 (2019)."}, {"t": "PD 957 operates only prospectively", "b": "Not for Secs. 20, 21 and 23, which the Court applied retroactively in Eugenio v. Drilon (1996)."}, {"t": "PD 957 and PD 1216 are the same decree", "b": "False. PD 1216 only amends Sec. 31 on open space."}];
const quiz=[{"q": "PD 957 was signed on:", "opts": ["Jul 12, 1976", "Oct 14, 1977", "Apr 2, 1978", "Mar 25, 1982"], "a": 0, "ex": "July 12, 1976, by Pres. Marcos."}, {"q": "Which section is the non-forfeiture of payments rule?", "opts": ["Sec. 17", "Sec. 20", "Sec. 23", "Sec. 25"], "a": 2, "ex": "Sec. 23."}, {"q": "A buyer who stops paying because the developer failed to develop may recover:", "opts": ["Only the principal", "Total paid including amortization interest but excluding delinquency interest, with legal interest", "Nothing", "Only delinquency interest"], "a": 1, "ex": "That is the Sec. 23 refund."}, {"q": "Which section requires delivery of title upon full payment?", "opts": ["Sec. 5", "Sec. 17", "Sec. 25", "Sec. 31"], "a": 2, "ex": "Sec. 25."}, {"q": "Before selling lots or units, the developer must obtain:", "opts": ["A License to Sell", "A mayor's permit only", "An SEC clearance only", "A DENR clearance"], "a": 0, "ex": "Sec. 5."}, {"q": "Contracts to sell must be registered with the Register of Deeds:", "opts": ["Only when fully paid", "Whether or not fully paid", "Only for condominiums", "Never"], "a": 1, "ex": "Sec. 17."}, {"q": "Which body currently adjudicates PD 957 buyer complaints?", "opts": ["NHA", "HLURB", "HSAC", "SEC"], "a": 2, "ex": "HSAC under RA 11201."}, {"q": "Which law amends Sec. 31 of PD 957?", "opts": ["PD 1344", "PD 1216", "BP 220", "RA 6552"], "a": 1, "ex": "PD 1216."}, {"q": "The Maceda Law applies when:", "opts": ["The developer defaults", "The buyer defaults in installment payments", "The title is delayed", "The project is unregistered"], "a": 1, "ex": "Maceda protects defaulting buyers."}, {"q": "For sales before the Decree, Sec. 21 gives the developer how long to comply?", "opts": ["6 months", "1 year", "2 years", "5 years"], "a": 2, "ex": "2 years from the Decree."}, {"q": "A mortgage on a project requires:", "opts": ["Nothing", "Prior written approval of the regulator", "Only buyer consent", "Only bank approval"], "a": 1, "ex": "Sec. 18."}, {"q": "Which case applied Secs. 20, 21 and 23 retroactively?", "opts": ["Solid Homes v. Payawal", "Eugenio v. Drilon", "Alangdeo v. Baguio", "Kalipunan v. Robredo"], "a": 1, "ex": "Eugenio v. Drilon (1996)."}];
const viewRoot=document.getElementById('viewRoot');const topbarTitle=document.getElementById('topbarTitle');let currentTab='home';let quizIdx=0,quizScore=0,quizAnswered=false;
function accordionHTML(articles){
  return articles.map((art) => `
    <div class="article-block">
      <div class="article-heading"><span>${art.heading}</span><span class="tag">${art.tag}</span></div>
      ${art.sections.map((s) => `
        <div class="sec-card" data-search="${(s.title+' '+s.num+' '+s.body+(s.trap||'')).toLowerCase().replace(/"/g,'&quot;')}">
          <button class="sec-head" onclick="toggleSec(this)">
            <span class="sec-num">${s.num}</span>
            <span class="sec-title">${s.title}</span>
            <svg class="sec-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="sec-body"><div class="sec-body-inner">
            ${s.body}
            ${s.trap ? `<div class="trap-box"><span class="lbl">TRAP</span><span>${s.trap}</span></div>` : ''}
          </div></div>
        </div>
      `).join('')}
    </div>
  `).join('');
}

function toggleSec(btn){
  const card = btn.closest('.sec-card');
  const body = card.querySelector('.sec-body');
  const isOpen = card.classList.contains('open');
  if(isOpen){
    card.classList.remove('open');
    body.style.maxHeight = null;
  } else {
    card.classList.add('open');
    body.style.maxHeight = body.scrollHeight + 40 + 'px';
  }
}

function renderHome(){topbarTitle.textContent='Overview';viewRoot.innerHTML=`
<div class="view-header"><div class="eyebrow-row"><span class="badge-pill">Buyer Protection</span></div><h1 class="view-title">PD 957 — Subdivision and Condominium Buyers' Protective Decree</h1>
<p class="view-sub">Regulates the sale of subdivision lots and condominium units: registration, license to sell, developer duties, buyer remedies and penalties. Relevant to REB Special and Technical and REA Land Management.</p></div>
<div class="stat-row"><div class="stat-card"><div class="n">1976</div><div class="l">Signed Jul 12, 1976</div></div><div class="stat-card"><div class="n">Sec. 23</div><div class="l">Non-forfeiture of payments (developer default)</div></div><div class="stat-card"><div class="n">Sec. 25</div><div class="l">Title delivered upon full payment</div></div><div class="stat-card"><div class="n">HSAC</div><div class="l">Current adjudicator (RA 11201, 2019)</div></div></div>
<div class="quicklinks"><div class="qlink" onclick="switchTab('law')"><div class="qt">Core Provisions →</div><div class="qd">Definitions, registration, license to sell.</div></div><div class="qlink" onclick="switchTab('duties')"><div class="qt">Developer Duties →</div><div class="qd">Secs. 17-22, 25 and 31.</div></div><div class="qlink" onclick="switchTab('buyer')"><div class="qt">Buyer Remedies →</div><div class="qd">Sec. 23, Maceda comparison, penalties.</div></div><div class="qlink" onclick="switchTab('related')"><div class="qt">Related Laws →</div><div class="qd">PD 1216, PD 1344, BP 220, RA 6552 and more.</div></div></div>`;}
function renderDates(){topbarTitle.textContent='Important Dates';viewRoot.innerHTML=`<div class="view-header"><div class="eyebrow-row"><span class="badge-pill">When</span></div><h1 class="view-title">Important Dates</h1><p class="view-sub">Chronology of PD 957 and the laws around it.</p></div><div class="home-timeline">${dates.map(t=>`<div class="tl-item" data-search="${(t.date+' '+t.title+' '+t.desc).toLowerCase().replace(/"/g,'&quot;')}"><div class="tl-date">${t.date}</div><div class="tl-title">${t.title}</div><div class="tl-desc">${t.desc}</div></div>`).join('')}</div>`;}
function renderPeople(){topbarTitle.textContent='Important People';viewRoot.innerHTML=`<div class="view-header"><div class="eyebrow-row"><span class="badge-pill">Who</span></div><h1 class="view-title">Important People and Institutions</h1><p class="view-sub">Presidents, agencies and stakeholders tied to PD 957.</p></div><div class="people-grid">${people.map(p=>`<div class="p-card" data-search="${(p.name+' '+p.role+' '+p.desc).toLowerCase().replace(/"/g,'&quot;')}"><div class="p-name">${p.name}</div><div class="p-role">${p.role}</div><div class="p-desc">${p.desc}</div></div>`).join('')}</div>`;}
function renderLaw(){topbarTitle.textContent='Core Provisions';viewRoot.innerHTML=`<div class="view-header"><div class="eyebrow-row"><span class="badge-pill">Secs. 1-15</span></div><h1 class="view-title">Core Provisions of PD 957</h1><p class="view-sub">Purpose, definitions, registration and license to sell.</p></div><div id="lawSections">${accordionHTML(lawArticles)}</div>`;}
function renderDuties(){topbarTitle.textContent='Developer Duties';viewRoot.innerHTML=`<div class="view-header"><div class="eyebrow-row"><span class="badge-pill">Secs. 17-31</span></div><h1 class="view-title">Developer Obligations</h1><p class="view-sub">Registration of contracts, mortgages, completion, title and open space.</p></div><div id="dutiesSections">${accordionHTML(dutiesArticles)}</div>`;}
function renderBuyer(){topbarTitle.textContent='Buyer Remedies';viewRoot.innerHTML=`<div class="view-header"><div class="eyebrow-row"><span class="badge-pill">Sec. 23, 38-39</span></div><h1 class="view-title">Buyer Remedies and Penalties</h1><p class="view-sub">Non-forfeiture, the Maceda comparison, forum and penalties.</p></div><div id="buyerSections">${accordionHTML(buyerArticles)}</div>`;}
function renderRelated(){topbarTitle.textContent='Related Laws';viewRoot.innerHTML=`<div class="view-header"><div class="eyebrow-row"><span class="badge-pill">Distinctions</span></div><h1 class="view-title">Related Laws</h1><p class="view-sub">Amendments, enforcement decrees and overlapping statutes.</p></div><div id="relatedSections">${accordionHTML(relatedArticles)}</div>`;}
function renderGlossary(){
  topbarTitle.textContent = 'Glossary';
  viewRoot.innerHTML = `
    <div class="view-header">
      <div class="eyebrow-row"><span class="badge-pill">Terms</span></div>
      <h1 class="view-title">Glossary of Terms</h1>
      <p class="view-sub">Subdivision, condominium and regulatory terms in one place.</p>
    </div>
    <div class="glossary-grid">
      ${glossary.map(g => `
        <div class="g-card" data-search="${(g.term+' '+g.abbr+' '+g.def).toLowerCase().replace(/"/g,'&quot;')}">
          <span class="g-term">${g.term}</span><span class="g-abbr">${g.abbr}</span>
          <div class="g-def">${g.def}</div>
        </div>
      `).join('')}
    </div>
  `;
}

function renderTraps(){
  topbarTitle.textContent = 'Board Exam Traps';
  viewRoot.innerHTML = `
    <div class="view-header">
      <div class="eyebrow-row"><span class="badge-pill">Developer-default vs. buyer-default gotchas</span></div>
      <h1 class="view-title">Board Exam Traps</h1>
      <p class="view-sub">PD 957 vs. Maceda Law, Sec. 23 refund components, and outdated agency names.</p>
    </div>
    <div class="trap-list">
      ${traps.map((t,i) => `
        <div class="trap-item" data-search="${(t.t+' '+t.b).toLowerCase().replace(/"/g,'&quot;')}">
          <div class="tnum">TRAP ${i+1}</div>
          <div class="ttitle">${t.t}</div>
          <div class="tbody">${t.b}</div>
        </div>
      `).join('')}
    </div>
  `;
}

function renderQuiz(reset){
  topbarTitle.textContent = 'Self-Test Quiz';
  if(reset){ quizIdx = 0; quizScore = 0; }
  quizAnswered = false;

  if(quizIdx >= quiz.length){
    viewRoot.innerHTML = `
      <div class="view-header">
        <div class="eyebrow-row"><span class="badge-pill">Results</span></div>
        <h1 class="view-title">Quiz Complete</h1>
      </div>
      <div class="quiz-box">
        <div class="quiz-score">${quizScore} / ${quiz.length} correct
          <div class="sub">${quizScore === quiz.length ? "Perfect score — ready for the board." : quizScore/quiz.length >= 0.7 ? "Solid — review the misses below and go again." : "Keep drilling the section numbers and dates, then retake."}</div>
        </div>
        <div class="quiz-nav" style="justify-content:center;">
          <button class="btn" onclick="renderQuiz(true)">Retake Quiz</button>
        </div>
      </div>
    `;
    return;
  }

  const item = quiz[quizIdx];
  viewRoot.innerHTML = `
    <div class="view-header">
      <div class="eyebrow-row"><span class="badge-pill">Self-Test</span></div>
      <h1 class="view-title">PD 957 Quiz</h1>
      <p class="view-sub">Questions on PD 957: licensing, developer duties, Sec. 23 non-forfeiture, penalties and agency lineage.</p>
    </div>
    <div class="quiz-box">
      <div class="quiz-progress">Question ${quizIdx+1} of ${quiz.length} &nbsp;·&nbsp; Score so far: ${quizScore}</div>
      <div class="quiz-q">${item.q}</div>
      <div class="quiz-opts">
        ${item.opts.map((o,i) => `<button class="quiz-opt" onclick="answerQuiz(${i})">${o}</button>`).join('')}
      </div>
      <div class="quiz-explain" id="quizExplain">${item.ex}</div>
      <div class="quiz-nav">
        <button class="btn ghost" onclick="renderQuiz(true)">Restart</button>
        <button class="btn" id="quizNextBtn" style="opacity:.4; pointer-events:none;" onclick="nextQuiz()">Next →</button>
      </div>
    </div>
  `;
}

function answerQuiz(i){
  if(quizAnswered) return;
  quizAnswered = true;
  const item = quiz[quizIdx];
  const opts = document.querySelectorAll('.quiz-opt');
  opts.forEach((btn, idx) => {
    btn.classList.add('disabled');
    if(idx === item.a) btn.classList.add('correct');
    else if(idx === i) btn.classList.add('wrong');
  });
  if(i === item.a) quizScore++;
  document.getElementById('quizExplain').classList.add('show');
  const nb = document.getElementById('quizNextBtn');
  nb.style.opacity = 1;
  nb.style.pointerEvents = 'auto';
}

function nextQuiz(){
  quizIdx++;
  renderQuiz(false);
}

/* ============================================================
   TAB SWITCHING + SEARCH
   ============================================================ */
const renderers = {
  home: renderHome, law: renderLaw, duties: renderDuties, buyer: renderBuyer, related: renderRelated,
  dates: renderDates, people: renderPeople, glossary: renderGlossary, traps: renderTraps,
  quiz: () => renderQuiz(true)
};

function switchTab(tab){
  currentTab = tab;
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.toggle('active', b.dataset.tab === tab));
  document.getElementById('searchInput').value = '';
  renderers[tab]();
  window.scrollTo(0,0);
}

document.querySelectorAll('.tab-btn').forEach(btn => {
  btn.addEventListener('click', () => switchTab(btn.dataset.tab));
});

document.getElementById('searchInput').addEventListener('input', (e) => {
  const q = e.target.value.trim().toLowerCase();
  const searchable = document.querySelectorAll('[data-search]');
  if(!q){
    searchable.forEach(el => el.classList.remove('hidden'));
    document.querySelectorAll('.article-block, .article-heading').forEach(el => el.classList.remove('hidden'));
    const nores = document.getElementById('noResults');
    if(nores) nores.remove();
    return;
  }
  let anyVisible = false;
  searchable.forEach(el => {
    const match = el.dataset.search.includes(q);
    el.classList.toggle('hidden', !match);
    if(match) anyVisible = true;
    if(match && el.classList.contains('sec-card')){
      el.classList.add('open');
      const body = el.querySelector('.sec-body');
      if(body) body.style.maxHeight = body.scrollHeight + 40 + 'px';
    }
  });
  let nores = document.getElementById('noResults');
  if(!anyVisible){
    if(!nores){
      nores = document.createElement('div');
      nores.id = 'noResults';
      nores.className = 'nores';
      nores.textContent = 'No matches in this section. Try another tab.';
      viewRoot.appendChild(nores);
    }
  } else if(nores){
    nores.remove();
  }
});

/* init */
renderHome();
</script>
